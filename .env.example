# CycloneShield AI - Environment Variables Template

# Operating Mode
DEMO_MODE=true
CYCLONE_REFRESH_INTERVAL_MINUTES=15

# Google Maps Platform (Optional: works with high-performance Leaflet dark tactical map if omitted)
GOOGLE_MAPS_API_KEY=

# Google Gemini / Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# Google Earth Engine
EARTH_ENGINE_PROJECT=

# Database (PostgreSQL + PostGIS in production, SQLite fallback for local development)
DATABASE_URL=sqlite:///./cycloneshield.db

# CORS Allowed Origins (Comma-separated list of origins for production)
CORS_ORIGINS=https://cyclone-detector.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Server Port (automatically injected by Render/Cloud Run/Railway)
PORT=8000
