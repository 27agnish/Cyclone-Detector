# CycloneShield AI - Secret & Environment Protection .gitignore

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials/
secrets/
service-account*.json
*-key.json

# Local Databases
*.sqlite3
*.db

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Node & Frontend Distribution
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log

# IDE & OS Artifacts
.DS_Store
.idea/
.vscode/
*.swp
