# CycloneShield AI - Backend Environment Template
# Copy this file to backend/.env and populate with your configuration.
# NEVER commit real keys or backend/.env to version control.

# Google Cloud Project & Location
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Gemini & Vertex AI Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini API Key (or use GOOGLE_APPLICATION_CREDENTIALS below)
GEMINI_API_KEY=

# Local Google Cloud Service Account Credentials file path (optional)
GOOGLE_APPLICATION_CREDENTIALS=

# Google Maps Platform Server Key (Optional)
GOOGLE_MAPS_API_KEY=

# Earth Engine Project ID (Optional)
EARTH_ENGINE_PROJECT=

# Database Connection String (PostgreSQL in production; SQLite fallback for local dev)
DATABASE_URL=sqlite:///./cycloneshield.db

# Operational Mode
DEMO_MODE=true
CYCLONE_REFRESH_INTERVAL_MINUTES=15
