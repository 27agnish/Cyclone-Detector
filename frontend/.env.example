# CycloneShield AI - Frontend Environment Template
# Copy this file to frontend/.env.local and configure your keys.
# NEVER commit real keys or .env.local to version control.

# FastAPI Backend Base URL
# Development: http://127.0.0.1:8000
# Single-Deployment Vercel: /api (same-origin relative URL)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Operational Demo Mode
VITE_DEMO_MODE=true
