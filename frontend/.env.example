# CycloneShield AI - Frontend Environment Template
# Copy this file to frontend/.env.local and configure your keys.
# NEVER commit real keys or .env.local to version control.

# Google Maps JavaScript API Key (Must be restricted to your domain or localhost)
VITE_GOOGLE_MAPS_API_KEY=

# FastAPI Backend Base URL (Defaults to http://localhost:8000 if blank)
VITE_API_BASE_URL=http://localhost:8000
