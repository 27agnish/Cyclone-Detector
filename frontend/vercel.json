{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py?_path=/api/v1/$1"
    },
    {
      "source": "/api/v1",
      "destination": "/api/index.py?_path=/api/v1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?_path=/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
